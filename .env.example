# GEMINI_API_KEY: Required for Gemini AI API calls.
# The local development environment can provide this value via environment variables or a secrets manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Deployment platforms can inject this at runtime with the app's public URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase expense sync (optional)
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
VITE_SUPABASE_EXPENSES_TABLE="budget_expenses"
VITE_SUPABASE_CHECKLIST_TABLE="trip_checklist_items"
VITE_SUPABASE_MAP_TABLE="trip_map_itineraries"
VITE_SUPABASE_NOTES_TABLE="trip_scratch_notes"
VITE_TRIP_KEY="jessie-amor-malaysia-singapore"
